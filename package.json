{
  "name": "voicechat",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,vite -c cyan,magenta \"bun run server/index.ts\" \"vite\"",
    "dev:server": "bun run server/index.ts",
    "dev:client": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "create-agent": "bun run server/createAgent.ts",
    "update-agent": "bun run server/updateAgent.ts"
  },
  "dependencies": {
    "@elevenlabs/react": "^1.12.0",
    "clsx": "^2.1.1",
    "hono": "^4.13.0",
    "lucide-react": "^1.29.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^10.0.4",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
