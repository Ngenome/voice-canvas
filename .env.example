# ==========================================
# ElevenLabs Conversational AI Configuration
# ==========================================

# Your ElevenLabs API Key (found in ElevenLabs Dashboard -> Profile -> API Keys)
ELEVENLABS_API_KEY=xi-api-key-here

# Your ElevenLabs Agent ID (from Conversational AI -> Agents)
ELEVENLABS_AGENT_ID=agent_your_agent_id_here

# Backend API server port (default 3002)
PORT=3002

# ==========================================
# Optional services (leave blank to skip)
# ==========================================

# Conversation summaries for long sessions (DigitalOcean serverless inference)
DIGITALOCEAN_MODEL_ACCESS_KEY=
# SUMMARY_MODEL=glm-5.3-flash
# SUMMARY_FALLBACK_MODEL=deepseek-v4.1-flash

# Web search for the agent. Works without keys (Exa free tier, then DuckDuckGo / Jina Reader);
# keys lift rate limits and add TinyFish as a fallback.
EXA_API_KEY=
TINYFISH_API_KEY=
